ADUC_SECRET_KEY=change-me
ADUC_LDAP_SERVER=ldaps://ad.example.com
ADUC_LDAP_BASE_DN=DC=example,DC=com
ADUC_LDAP_BIND_DN=CN=svc-aduc,OU=Service Accounts,DC=example,DC=com
ADUC_LDAP_BIND_PASSWORD=change-me
ADUC_LDAP_USE_STARTTLS=false
ADUC_LDAP_VERIFY_CERT=true
ADUC_LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
ADUC_LDAP_GROUP_FILTER=(objectClass=group)
ADUC_LDAP_USER_ATTRIBUTES=cn,sAMAccountName,displayName,mail,userAccountControl,memberOf,distinguishedName
ADUC_LDAP_GROUP_ATTRIBUTES=cn,description,distinguishedName,member
ADUC_LDAP_ALLOWED_GROUP_DN=CN=ADUC-Admins,OU=Security Groups,DC=example,DC=com
ADUC_WINRM_HOST=10.0.0.10
ADUC_WINRM_USER=EXAMPLE\\aduc-operator
ADUC_WINRM_PASSWORD=change-me
ADUC_WINRM_TRANSPORT=ntlm
ADUC_WINRM_USE_SSL=false
ADUC_WINRM_PORT=5985
ADUC_AUDIT_LOG_PATH=/var/log/aduc-web/audit.log
