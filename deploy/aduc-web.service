[Unit]
Description=ADUC Web Console
After=network.target

[Service]
Type=simple
User=aduc
Group=aduc
WorkingDirectory=/opt/aduc-web
Environment=PYTHONUNBUFFERED=1
Environment=ADUC_ENV=production
EnvironmentFile=/etc/aduc-web/aduc-web.env
ExecStart=/opt/aduc-web/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
